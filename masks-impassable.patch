+    private void SyncModeButtons()
+    {
+        _syncingMode = true;
+        _manual.Checked = _mode == ImpassablePaintMode.Manual;
+        _manualPlusAuto.Checked = _mode == ImpassablePaintMode.ManualPlusAuto;
+        _showAuto.Enabled = _mode == ImpassablePaintMode.ManualPlusAuto;
+        _syncingMode = false;
