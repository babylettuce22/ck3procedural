# The society panel. Opened by the HUD tab beside Intrigue (Emit/GuiWriter.cs patches it in).
#
# The window mechanics -- the full-screen transparent host, the layer on the host only, the
# main-tab size template, the IsRightWindowOpen exclusion, Escape via close_window, the _hide state
# clearing the open flag -- are the prototype's, and every one of them was a bug before it was a
# line. BaseFilesToCopy/SocietyPrototype/gui/gen_society_panel.gui explains each at length; read it
# before changing any of them.
#
# What changed is what the panel is FOR. The prototype drew a rank ladder and two meters about a
# society with no name and no goal. This one answers the questions a sworn player actually has,
# top to bottom:
#
#   1. What are we for?            -- the aim, in one sentence, naming the crown and the house
#   2. Who matters?                -- the heir, the Keeper, the usurper (or the king, once restored)
#   3. How close are we?           -- support, and what the next milestone opens
#   4. Where do I stand?           -- my rung, favour, exposure
#   5. What should I do next?      -- my charge, and the actions I can take, lit when I can take them
#   6. Who else?                   -- the roster I am trusted to know
#
# Every number and person is read off the VIEWER as a variable restor_panel_gather copied there
# (GetGlobalVariable resolves to nothing in a .gui).

types gen_society_panel {

	type gen_society_panel_host = window {
		name = "gen_society_panel_host"
		allow_outside = yes
		parentanchor = center
		size = { 100% 100% }
		alwaystransparent = yes
		layer = windows_layer
		visible = "[And( Not( IsPauseMenuShown ), And( Or( Not( IsObserver ), GetPlayer.IsValid ), IsDefaultGUIMode ) )]"

		gen_society_panel_window = {}
	}

	type gen_society_panel_window = window {
		name = "gen_society_panel_window"
		allow_outside = yes
		movable = no
		parentanchor = top|right
		using = Window_Size_MainTab

		visible = "[And( And( GetScriptedGui('society_panel_window').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), GetScriptedGui('restor_panel_viewer_member').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ), Not( IsRightWindowOpen ) )]"

		state = {
			name = _show
			using = Window_Position_MainTab
			using = Animation_FadeIn_Quick
			using = Sound_WindowShow_Standard
			on_start = "[GetScriptedGui('restor_panel_gather').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		}

		state = {
			name = _hide
			using = Window_Position_MainTab_Hide
			using = Animation_FadeOut_Quick
			using = Sound_WindowHide_Standard
			on_start = "[GetScriptedGui('society_panel_window').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		}

		margin_widget = {
			size = { 100% 100% }
			margin_top = 30
			margin_bottom = 25
			margin_right = 13

			widget = {
				size = { 100% 100% }

				# Every paragraph's max_width (restor_para) is 520, and it is a budget: a max_width wider than the
				# room does not wrap early, it pushes the whole panel out past the screen's right edge
				# (seen on screen at 600). 655 (Window_Size_MainTab) - 13 margin_right - 80
				# Window_Margins - 20 box margins leaves ~540 (measured on screen: a 500 paragraph
				# centred with 20px either side). Same lesson as ChronicleWindow.RowWidth.
				vbox = {
					using = Window_Margins
					spacing = 6

					# ---- 1. Title and aim ----------------------------------------------------------

					header_standard = {
						layoutpolicy_horizontal = expanding
						blockoverride "header_text" {
							text = "RESTOR_PANEL_TITLE"
						}
						blockoverride "button_close" {
							datacontext = "[GetScriptedGui( 'society_panel_window' )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							shortcut = "close_window"
						}
					}

					restor_para = {
						margin_left = 10
						visible = "[GetScriptedGui('restor_panel_underground').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						blockoverride "para" { text = "RESTOR_PANEL_AIM" }
					}
					restor_para = {
						margin_left = 10
						visible = "[GetScriptedGui('restor_panel_restored').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						blockoverride "para" { text = "RESTOR_PANEL_AIM_PUBLIC" }
					}

					# ---- 2. The people --------------------------------------------------------------

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						margin = { 10 6 }
						background = {
							texture = "gfx/interface/component_masks/mask_brushed.dds"
							color = { 0.2 0.2 0.31 0.45 }
						}

						restor_person_slot = {
							visible = "[GetScriptedGui('restor_panel_has_pretender').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							datacontext = "[GetPlayer.MakeScope.Var('restor_panel_pretender').Char]"
							blockoverride "slot_label" { text = "RESTOR_PANEL_HEIR" }
						}
						restor_person_slot = {
							visible = "[GetScriptedGui('restor_panel_has_king').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							datacontext = "[GetPlayer.MakeScope.Var('restor_panel_king').Char]"
							blockoverride "slot_label" { text = "RESTOR_PANEL_KING" }
						}
						restor_person_slot = {
							visible = "[GetScriptedGui('restor_panel_has_keeper').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							datacontext = "[GetPlayer.MakeScope.Var('restor_panel_keeper').Char]"
							blockoverride "slot_label" { text = "RESTOR_PANEL_KEEPER" }
						}
						restor_person_slot = {
							visible = "[GetScriptedGui('restor_panel_has_usurper').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							datacontext = "[GetPlayer.MakeScope.Var('restor_panel_usurper').Char]"
							blockoverride "slot_label" { text = "RESTOR_PANEL_USURPER" }
						}
						expand = {}
					}

					# ---- 3 & 4. Support, standing, meters -----------------------------------------------

					vbox = {
						layoutpolicy_horizontal = expanding
						margin = { 10 6 }
						spacing = 4
						background = {
							texture = "gfx/interface/component_masks/mask_brushed.dds"
							color = { 0.2 0.2 0.31 0.45 }
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6
							visible = "[GetScriptedGui('restor_panel_underground').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							text_single = {
								default_format = "#weak"
								text = "RESTOR_PANEL_SUPPORT_LABEL"
							}
							text_single = {
								default_format = "#high"
								text = "[GetPlayer.MakeScope.Var('restor_panel_support').GetValue|0] / 100"
							}
							expand = {}
							text_single = {
								default_format = "#weak"
								text = "RESTOR_PANEL_LAND_LABEL"
							}
							text_single = {
								default_format = "#high"
								text = "[GetPlayer.MakeScope.Var('restor_panel_share').GetValue|0]%"
							}
							expand = {}
							text_single = {
								default_format = "#weak"
								text = "RESTOR_PANEL_WAR_CHEST_LABEL"
							}
							text_single = {
								default_format = "#high"
								text = "[GetPlayer.MakeScope.Var('restor_panel_war_chest').GetValue|0]"
							}
						}
						restor_para = {
							visible = "[GetScriptedGui('restor_panel_underground').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							blockoverride "para" { default_format = "#weak" text = "RESTOR_PANEL_SUPPORT_NEXT" }
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 14
							text_single = {
								default_format = "#weak"
								text = "RESTOR_PANEL_STANDING_LABEL"
							}
							restor_rung_chip = {
								blockoverride "chip_lit" { text = "RESTOR_RANK_0" visible = "[GetScriptedGui('restor_panel_rank_0').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
								blockoverride "chip_dim" { text = "RESTOR_RANK_0" visible = "[Not( GetScriptedGui('restor_panel_rank_0').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]" }
							}
							restor_rung_chip = {
								blockoverride "chip_lit" { text = "RESTOR_RANK_1" visible = "[GetScriptedGui('restor_panel_rank_1').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
								blockoverride "chip_dim" { text = "RESTOR_RANK_1" visible = "[Not( GetScriptedGui('restor_panel_rank_1').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]" }
							}
							restor_rung_chip = {
								blockoverride "chip_lit" { text = "RESTOR_RANK_2" visible = "[GetScriptedGui('restor_panel_rank_2').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
								blockoverride "chip_dim" { text = "RESTOR_RANK_2" visible = "[Not( GetScriptedGui('restor_panel_rank_2').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]" }
							}
							restor_rung_chip = {
								blockoverride "chip_lit" { text = "RESTOR_RANK_3" visible = "[GetScriptedGui('restor_panel_rank_3').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
								blockoverride "chip_dim" { text = "RESTOR_RANK_3" visible = "[Not( GetScriptedGui('restor_panel_rank_3').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]" }
							}
							expand = {}
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6
							text_single = {
								default_format = "#weak"
								text = "RESTOR_PANEL_FAVOUR_LABEL"
							}
							text_single = {
								default_format = "#high"
								text = "[GetPlayer.MakeScope.Var('restor_favour').GetValue|0]"
							}
							expand = {}
							text_single = {
								default_format = "#weak"
								text = "RESTOR_PANEL_EXPOSURE_LABEL"
								visible = "[GetScriptedGui('restor_panel_underground').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							}
							text_single = {
								default_format = "#high"
								text = "[GetPlayer.MakeScope.Var('restor_exposure').GetValue|0]"
								visible = "[GetScriptedGui('restor_panel_underground').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							}
						}
					}

					# ---- 5. What to do next --------------------------------------------------------

					text_single = {
						layoutpolicy_horizontal = expanding
						margin_top = 4
						margin_left = 10
						align = left
						default_format = "#weak"
						text = "RESTOR_PANEL_NEXT_HEADER"
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						margin = { 10 6 }
						spacing = 3
						background = {
							texture = "gfx/interface/component_masks/mask_brushed.dds"
							color = { 0.2 0.2 0.31 0.45 }
						}

						restor_para = {
							visible = "[GetScriptedGui('restor_panel_underground').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							blockoverride "para" { text = "RESTOR_PANEL_CHARGE" }
						}

						restor_action_row = {
							visible = "[GetScriptedGui('restor_panel_viewer_is_pretender').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							blockoverride "action_lit" { text = "RESTOR_PANEL_ACTION_CROWN" visible = "[GetScriptedGui('restor_panel_can_crown').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
							blockoverride "action_dim" { text = "RESTOR_PANEL_ACTION_CROWN" visible = "[Not( GetScriptedGui('restor_panel_can_crown').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]" }
						}
						restor_action_row = {
							visible = "[GetScriptedGui('restor_panel_viewer_is_pretender').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							blockoverride "action_lit" { text = "RESTOR_PANEL_ACTION_RAISE" visible = "[GetScriptedGui('restor_panel_can_raise').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
							blockoverride "action_dim" { text = "RESTOR_PANEL_ACTION_RAISE" visible = "[Not( GetScriptedGui('restor_panel_can_raise').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]" }
						}
						restor_action_row = {
							visible = "[Not( GetScriptedGui('restor_panel_viewer_is_pretender').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
							blockoverride "action_lit" { text = "RESTOR_PANEL_ACTION_GIVE" visible = "[GetScriptedGui('restor_panel_can_give').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
							blockoverride "action_dim" { text = "RESTOR_PANEL_ACTION_GIVE" visible = "[Not( GetScriptedGui('restor_panel_can_give').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]" }
						}
						restor_action_row = {
							blockoverride "action_lit" { text = "RESTOR_PANEL_ACTION_GATHER" visible = "[GetScriptedGui('restor_panel_can_gather').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
							blockoverride "action_dim" { text = "RESTOR_PANEL_ACTION_GATHER" visible = "[Not( GetScriptedGui('restor_panel_can_gather').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]" }
						}
						restor_action_row = {
							blockoverride "action_lit" { text = "RESTOR_PANEL_ACTION_ERRAND" visible = "[GetScriptedGui('restor_panel_underground').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
							blockoverride "action_dim" { text = "RESTOR_PANEL_ACTION_ERRAND" visible = "[Not( GetScriptedGui('restor_panel_underground').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]" }
						}
						restor_para = {
							blockoverride "para" { default_format = "#weak" text = "RESTOR_PANEL_POWERS_HINT" }
						}
					}

					# ---- 6. The roster --------------------------------------------------------------

					text_single = {
						layoutpolicy_horizontal = expanding
						margin_top = 4
						margin_left = 10
						align = left
						default_format = "#weak"
						text = "RESTOR_PANEL_ROSTER_HEADER"
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						blockoverride "scrollbox_content" {
							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								datamodel = "[GetPlayer.MakeScope.GetList( 'restor_panel_roster' )]"

								item = {
									hbox = {
										datacontext = "[Scope.Char]"
										layoutpolicy_horizontal = expanding
										spacing = 10
										margin_right = 12
										background = {
											texture = "gfx/interface/component_masks/mask_brushed.dds"
											color = { 0.2 0.2 0.31 0.45 }
										}

										portrait_head_small = {}

										vbox = {
											layoutpolicy_horizontal = expanding
											text_single = {
												layoutpolicy_horizontal = expanding
												align = left
												default_format = "#high"
												text = "[Character.GetName]"
											}
											text_single = {
												layoutpolicy_horizontal = expanding
												align = left
												default_format = "#weak"
												visible = "[Character.IsRuler]"
												text = "[Character.GetPrimaryTitle.GetNameNoTooltip]"
											}
										}

										vbox = {
											text_single = {
												align = right
												default_format = "#high"
												text = "RESTOR_ROSTER_HEIR"
												visible = "[GetScriptedGui('restor_panel_is_pretender').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
											}
											text_single = {
												align = right
												default_format = "#high"
												text = "RESTOR_ROSTER_KEEPER"
												visible = "[GetScriptedGui('restor_panel_is_keeper').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
											}
											text_single = {
												align = right
												text = "RESTOR_RANK_0"
												visible = "[GetScriptedGui('restor_panel_rank_0').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
											}
											text_single = {
												align = right
												text = "RESTOR_RANK_1"
												visible = "[GetScriptedGui('restor_panel_rank_1').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
											}
											text_single = {
												align = right
												text = "RESTOR_RANK_2"
												visible = "[GetScriptedGui('restor_panel_rank_2').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
											}
											text_single = {
												align = right
												text = "RESTOR_RANK_3"
												visible = "[GetScriptedGui('restor_panel_rank_3').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
											}
											text_single = {
												align = right
												default_format = "#V"
												text = "RESTOR_ROSTER_SUSPECT"
												visible = "[GetScriptedGui('restor_panel_suspect').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
											}
											text_single = {
												align = right
												default_format = "#X"
												text = "RESTOR_ROSTER_VERY_SUSPECT"
												visible = "[GetScriptedGui('restor_panel_very_suspect').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
											}
										}
									}
								}
							}
						}

						blockoverride "scrollbox_empty" {
							visible = "[IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'restor_panel_roster' ) )]"
							text = "RESTOR_PANEL_ROSTER_EMPTY"
						}
					}
				}
			}
		}
	}

	# One of the people at the top: a label, a face, a name. The face opens the character like any
	# vanilla portrait does.
	type restor_person_slot = vbox {
		spacing = 2
		minimumsize = { 130 -1 }
		text_single = {
			default_format = "#weak"
			align = hcenter
			block "slot_label" {}
		}
		portrait_head_small = {}
		text_single = {
			align = hcenter
			default_format = "#high"
			max_width = 130
			text = "[Character.GetFirstNameNoTooltip]"
		}
	}

	# An hbox, not a widget: a widget's autoresize does not measure its text children, so every chip
	# came out zero-wide and the four rungs printed on top of each other. ignoreinvisible so the hidden
	# half does not hold a gap.
	type restor_rung_chip = hbox {
		ignoreinvisible = yes
		text_single = {
			default_format = "#high"
			block "chip_lit" {}
		}
		text_single = {
			default_format = "#weak"
			block "chip_dim" {}
		}
	}

	# An action the viewer can take, lit when they can take it now and dimmed with its requirement
	# when they cannot. The text carries both halves; the colour says which applies.
	type restor_action_row = hbox {
		layoutpolicy_horizontal = expanding
		ignoreinvisible = yes
		text_single = {
			layoutpolicy_horizontal = expanding
			align = left
			default_format = "#high"
			block "action_lit" {}
		}
		text_single = {
			layoutpolicy_horizontal = expanding
			align = left
			default_format = "#weak"
			block "action_dim" {}
		}
	}

	# A wrapped paragraph held to the left edge. A bare text_multi narrower than its vbox is centred
	# in it, so paragraphs sat ~20px further in than the labels around them; the expand pushes this
	# one left. 520 fits the ~540 inside a margined box (the budget note above the main vbox).
	type restor_para = hbox {
		layoutpolicy_horizontal = expanding
		text_multi = {
			autoresize = yes
			max_width = 520
			block "para" {}
		}
		expand = {}
	}
}

gen_society_panel_host = {}
