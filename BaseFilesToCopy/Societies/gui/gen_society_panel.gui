# The society panel. Opened by the HUD tab beside Intrigue (Emit/GuiWriter.cs patches it in).
#
# The window mechanics -- the full-screen transparent host, the layer on the host only, the
# main-tab size template, the IsRightWindowOpen exclusion, Escape via close_window, the _hide state
# clearing the open flag -- are the prototype's, and every one of them was a bug before it was a
# line. BaseFilesToCopy/SocietyPrototype/gui/gen_society_panel.gui explains each at length; read it
# before changing any of them.
#
# What changed is what the panel is FOR. The prototype drew a rank ladder and two meters about a
# society with no name and no goal. This one answers the questions a sworn player actually has,
# top to bottom:
#
#   1. What are we for?            -- the aim, in one sentence, naming the crown and the house
#   2. Who matters?                -- the heir, the Keeper, the usurper (or the king, once restored)
#   3. How close are we?           -- support, and what the next milestone opens
#   4. Where do I stand?           -- my rung, favour, exposure
#   5. What should I do next?      -- my charge, and the actions I can take, lit when I can take them
#   6. Who else?                   -- the roster I am trusted to know
#
# Every number and person is read off the VIEWER as a variable restor_panel_gather copied there
# (GetGlobalVariable resolves to nothing in a .gui).

types gen_society_panel {

	type gen_society_panel_host = window {
		name = "gen_society_panel_host"
		allow_outside = yes
		parentanchor = center
		size = { 100% 100% }
		alwaystransparent = yes
		layer = windows_layer
		visible = "[And( Not( IsPauseMenuShown ), And( GetPlayer.IsValid, IsDefaultGUIMode ) )]"

		gen_society_panel_window = {}
		gen_restor_people_window = {}
	}

	type gen_society_panel_window = window {
		name = "gen_society_panel_window"
		allow_outside = yes
		movable = no
		parentanchor = top|right
		using = Window_Size_MainTab

		visible = "[And( GetPlayer.IsValid, And( And( GetScriptedGui('society_panel_window').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), GetScriptedGui('restor_panel_viewer_member').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ), Not( IsRightWindowOpen ) ) )]"

		state = {
			name = _show
			using = Window_Position_MainTab
			using = Animation_FadeIn_Quick
			using = Sound_WindowShow_Standard
			on_start = "[GetScriptedGui('restor_panel_gather').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		}

		state = {
			name = _hide
			using = Window_Position_MainTab_Hide
			using = Animation_FadeOut_Quick
			using = Sound_WindowHide_Standard
			on_start = "[GetScriptedGui('society_panel_window').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			on_start = "[GetVariableSystem.Clear( 'restor_people' )]"
		}

		# The refresh. The gather in _show runs once, on opening, so anything that changed while the
		# window stayed open -- a daily tick, an event option, a decision taken beside it -- showed
		# stale until it was closed and reopened. This invisible widget re-runs the gather once a
		# second, looping two states the way vanilla's event-window shimmer loops (next = each other).
		# The gather is cheap, rebuilds the roster only when its membership changed (so the list does
		# not flicker or lose its hover), and does nothing unless the panel is open.
		widget = {
			name = "restor_panel_tick"
			size = { 0 0 }

			state = {
				name = restor_panel_tick_a
				trigger_on_create = yes
				duration = 1
				next = restor_panel_tick_b
				on_finish = "[GetScriptedGui('restor_panel_gather').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}

			state = {
				name = restor_panel_tick_b
				duration = 0
				next = restor_panel_tick_a
			}
		}

		# The slow refresh of "Within reach": every fifteen seconds, since it walks every ruler. The
		# first build is the gather's, on opening.
		widget = {
			name = "restor_panel_reach_tick"
			size = { 0 0 }

			state = {
				name = restor_panel_reach_tick_a
				trigger_on_create = yes
				duration = 15
				next = restor_panel_reach_tick_b
				on_finish = "[GetScriptedGui('restor_panel_gather_reach').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}

			state = {
				name = restor_panel_reach_tick_b
				duration = 0
				next = restor_panel_reach_tick_a
			}
		}

		margin_widget = {
			size = { 100% 100% }
			margin_top = 30
			margin_bottom = 25
			margin_right = 13

			widget = {
				size = { 100% 100% }

				# Every paragraph's max_width (restor_para) is 520, and it is a budget: a max_width wider than the
				# room does not wrap early, it pushes the whole panel out past the screen's right edge
				# (seen on screen at 600). 655 (Window_Size_MainTab) - 13 margin_right - 80
				# Window_Margins - 20 box margins leaves ~540 (measured on screen: a 500 paragraph
				# centred with 20px either side). Same lesson as ChronicleWindow.RowWidth.
				vbox = {
					using = Window_Margins
					spacing = 6

					# ---- 1. Title and aim ----------------------------------------------------------

					header_standard = {
						layoutpolicy_horizontal = expanding
						blockoverride "header_text" {
							text = "RESTOR_PANEL_TITLE"
						}
						blockoverride "button_close" {
							datacontext = "[GetScriptedGui( 'society_panel_window' )]"
							onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							shortcut = "close_window"
						}
					}

					restor_para = {
						margin_left = 10
						visible = "[GetScriptedGui('restor_panel_underground').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						blockoverride "para" { text = "RESTOR_PANEL_AIM" }
					}
					restor_para = {
						margin_left = 10
						visible = "[GetScriptedGui('restor_panel_restored').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						blockoverride "para" { text = "RESTOR_PANEL_AIM_PUBLIC" }
					}

					# ---- 2. The people --------------------------------------------------------------

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						margin = { 14 8 }
						background = { using = Background_Area_Dark }

						restor_person_slot = {
							visible = "[GetScriptedGui('restor_panel_has_pretender').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							datacontext = "[GetPlayer.MakeScope.Var('restor_panel_pretender').Char]"
							blockoverride "slot_label" { text = "RESTOR_PANEL_HEIR" }
						}
						restor_person_slot = {
							visible = "[GetScriptedGui('restor_panel_has_king').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							datacontext = "[GetPlayer.MakeScope.Var('restor_panel_king').Char]"
							blockoverride "slot_label" { text = "RESTOR_PANEL_KING" }
						}
						restor_person_slot = {
							visible = "[GetScriptedGui('restor_panel_has_keeper').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							datacontext = "[GetPlayer.MakeScope.Var('restor_panel_keeper').Char]"
							blockoverride "slot_label" { text = "RESTOR_PANEL_KEEPER" }
						}
						restor_person_slot = {
							visible = "[GetScriptedGui('restor_panel_has_usurper').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							datacontext = "[GetPlayer.MakeScope.Var('restor_panel_usurper').Char]"
							blockoverride "slot_label" { text = "RESTOR_PANEL_USURPER" }
						}
						expand = {}
					}

					# ---- 3. The cause: how near the crown is ---------------------------------------------
					# Bars rather than "27 / 100". Each marker is where a door opens (its tooltip says
					# which), so the distance is seen, not worked out. Underground only: once the crown is
					# won, none of these numbers decide anything.
					#
					# The card is expanding; what is in it is not. It sits in a vbox as wide as its
					# widest child (the 510 bars), which the card centres, so every bar, label and value
					# lines up on the same two edges.

					text_label_left = {
						visible = "[GetScriptedGui('restor_panel_underground').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						text = "RESTOR_PANEL_CAUSE_HEADER"
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						margin = { 0 10 }
						visible = "[GetScriptedGui('restor_panel_underground').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
						background = { using = Background_Area_Dark }

						vbox = {
							spacing = 10

							restor_meter = {
								blockoverride "meter_label" { text = "RESTOR_PANEL_SUPPORT_LABEL" }
								blockoverride "meter_value" { raw_text = "[GetPlayer.MakeScope.Var('restor_panel_support').GetValue|0] / 100" }
								blockoverride "meter_tt" { tooltip = "RESTOR_PANEL_SUPPORT_NEXT" }
								blockoverride "meter_bar" {
									restor_bar = { value = "[GetPlayer.MakeScope.Var('restor_panel_support').GetValue]" }
								}
								blockoverride "meter_marks" {
									restor_mark = { position = { 202 -3 } tooltip = "RESTOR_PANEL_MARK_SUPPORT" }
								}
							}

							restor_meter = {
								blockoverride "meter_label" { text = "RESTOR_PANEL_LAND_LABEL" }
								blockoverride "meter_value" { raw_text = "[GetPlayer.MakeScope.Var('restor_panel_share').GetValue|0]%" }
								blockoverride "meter_tt" { tooltip = "RESTOR_PANEL_LAND_TT" }
								blockoverride "meter_bar" {
									restor_bar = { value = "[GetPlayer.MakeScope.Var('restor_panel_share').GetValue]" }
								}
								blockoverride "meter_marks" {
									restor_mark = { position = { 126 -3 } tooltip = "RESTOR_PANEL_MARK_LAND" }
								}
							}

							# Text and icon anchored straight onto the widget. An hbox anchored right|vcenter
							# here ignored the anchor in game, filled the row and centred its contents, which
							# put the gold icon on top of the label. The value's width is unknown, so the icon
							# sits a fixed 60px in from the right, room for five digits.
							widget = {
								size = { 510 24 }
								tooltip = "RESTOR_PANEL_WAR_CHEST_TT"
								text_single = {
									parentanchor = left|vcenter
									default_format = "#weak"
									text = "RESTOR_PANEL_WAR_CHEST_LABEL"
								}
								icon = {
									parentanchor = right|vcenter
									position = { -60 0 }
									size = { 22 22 }
									texture = "gfx/interface/icons/icon_gold.dds"
								}
								text_single = {
									parentanchor = right|vcenter
									default_format = "#high"
									raw_text = "[GetPlayer.MakeScope.Var('restor_panel_war_chest').GetValue|0]"
								}
							}
						}
					}

					# ---- 4. Your place: rung, favour, exposure -------------------------------------

					text_label_left = {
						text = "RESTOR_PANEL_PLACE_HEADER"
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						margin = { 0 10 }
						background = { using = Background_Area_Dark }

						vbox = {
							spacing = 10

							# The ladder: four plates, the viewer's lit. Only the current rung has a
							# scripted_gui, so rungs passed and rungs ahead look alike.
							hbox = {
								spacing = 3
								tooltip = "RESTOR_PANEL_STANDING_TT"
								restor_rung = {
									blockoverride "rung_text" { text = "RESTOR_RANK_0" }
									blockoverride "rung_on" { visible = "[GetScriptedGui('restor_panel_rank_0').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
									blockoverride "rung_off" { visible = "[Not( GetScriptedGui('restor_panel_rank_0').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]" }
								}
								restor_rung = {
									blockoverride "rung_text" { text = "RESTOR_RANK_1" }
									blockoverride "rung_on" { visible = "[GetScriptedGui('restor_panel_rank_1').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
									blockoverride "rung_off" { visible = "[Not( GetScriptedGui('restor_panel_rank_1').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]" }
								}
								restor_rung = {
									blockoverride "rung_text" { text = "RESTOR_RANK_2" }
									blockoverride "rung_on" { visible = "[GetScriptedGui('restor_panel_rank_2').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
									blockoverride "rung_off" { visible = "[Not( GetScriptedGui('restor_panel_rank_2').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]" }
								}
								restor_rung = {
									blockoverride "rung_text" { text = "RESTOR_RANK_3" }
									blockoverride "rung_on" { visible = "[GetScriptedGui('restor_panel_rank_3').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
									blockoverride "rung_off" { visible = "[Not( GetScriptedGui('restor_panel_rank_3').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]" }
								}
							}

							widget = {
								size = { 510 62 }

								# Favour is a currency with no ceiling, so it is a number, drawn large. Two
								# anchored labels, not a vbox: an anchored vbox here filled the widget in game
								# and centred itself over the exposure meter.
								text_single = {
									parentanchor = top|left
									default_format = "#weak"
									text = "RESTOR_PANEL_FAVOUR_LABEL"
									tooltip = "RESTOR_PANEL_FAVOUR_TT"
								}
								text_single = {
									parentanchor = top|left
									position = { 0 24 }
									using = Font_Size_Big
									default_format = "#high"
									raw_text = "[GetPlayer.MakeScope.Var('restor_favour').GetValue|0]"
									tooltip = "RESTOR_PANEL_FAVOUR_TT"
								}

								# Exposure: 0-40, marked at 15 (under suspicion) and 25 (highly suspect,
								# the usurper is told). 300 wide, so the marks sit at 111 and 186.
								restor_meter = {
									parentanchor = top|right
									visible = "[GetScriptedGui('restor_panel_underground').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
									blockoverride "meter_label" { text = "RESTOR_PANEL_EXPOSURE_LABEL" }
									blockoverride "meter_value" { raw_text = "[GetPlayer.MakeScope.Var('restor_exposure').GetValue|0]" }
									blockoverride "meter_tt" { tooltip = "RESTOR_PANEL_EXPOSURE_TT" }
									blockoverride "meter_size" { size = { 300 62 } }
									blockoverride "meter_bar" {
										restor_bar_red = {
											max = 40
											value = "[GetPlayer.MakeScope.Var('restor_exposure').GetValue]"
										}
									}
									blockoverride "meter_marks" {
										restor_mark = { position = { 111 -3 } tooltip = "RESTOR_PANEL_MARK_SUSPECT" }
										restor_mark = { position = { 186 -3 } tooltip = "RESTOR_PANEL_MARK_HIGHLY_SUSPECT" }
									}
									blockoverride "meter_note" {
										text_single = {
											parentanchor = bottom|right
											default_format = "#weak"
											text = "RESTOR_PANEL_EXPOSURE_CALM"
											visible = "[Not( Or( GetScriptedGui('restor_panel_suspect').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), GetScriptedGui('restor_panel_very_suspect').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
										}
										text_single = {
											parentanchor = bottom|right
											default_format = "#V"
											text = "RESTOR_PANEL_EXPOSURE_SUSPECT"
											visible = "[And( GetScriptedGui('restor_panel_suspect').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), Not( GetScriptedGui('restor_panel_very_suspect').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
										}
										text_single = {
											parentanchor = bottom|right
											default_format = "#X"
											text = "RESTOR_PANEL_EXPOSURE_HIGH"
											visible = "[GetScriptedGui('restor_panel_very_suspect').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
										}
									}
								}
							}
						}
					}

					# ---- 5. What to do next --------------------------------------------------------

					text_label_left = {
						text = "RESTOR_PANEL_NEXT_HEADER"
						tooltip = "RESTOR_PANEL_POWERS_HINT"
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						margin = { 14 8 }
						spacing = 4
						background = { using = Background_Area_Dark }

						restor_para = {
							visible = "[GetScriptedGui('restor_panel_underground').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							blockoverride "para" { text = "RESTOR_PANEL_CHARGE" }
						}

						restor_action_row = {
							visible = "[GetScriptedGui('restor_panel_viewer_is_pretender').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							blockoverride "action_tt" { tooltip = "RESTOR_PANEL_ACTION_CROWN_TT" }
							blockoverride "action_lit" { text = "RESTOR_PANEL_ACTION_CROWN" visible = "[GetScriptedGui('restor_panel_can_crown').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
							blockoverride "action_dim" { text = "RESTOR_PANEL_ACTION_CROWN" visible = "[Not( GetScriptedGui('restor_panel_can_crown').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]" }
						}
						restor_action_row = {
							visible = "[GetScriptedGui('restor_panel_viewer_is_pretender').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							blockoverride "action_tt" { tooltip = "RESTOR_PANEL_ACTION_RAISE_TT" }
							blockoverride "action_lit" { text = "RESTOR_PANEL_ACTION_RAISE" visible = "[GetScriptedGui('restor_panel_can_raise').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
							blockoverride "action_dim" { text = "RESTOR_PANEL_ACTION_RAISE" visible = "[Not( GetScriptedGui('restor_panel_can_raise').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]" }
						}
						restor_action_row = {
							visible = "[Not( GetScriptedGui('restor_panel_viewer_is_pretender').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
							blockoverride "action_tt" { tooltip = "RESTOR_PANEL_ACTION_GIVE_TT" }
							blockoverride "action_lit" { text = "RESTOR_PANEL_ACTION_GIVE" visible = "[GetScriptedGui('restor_panel_can_give').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
							blockoverride "action_dim" { text = "RESTOR_PANEL_ACTION_GIVE" visible = "[Not( GetScriptedGui('restor_panel_can_give').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]" }
						}
						restor_action_row = {
							blockoverride "action_tt" { tooltip = "RESTOR_PANEL_ACTION_GATHER_TT" }
							blockoverride "action_lit" { text = "RESTOR_PANEL_ACTION_GATHER" visible = "[GetScriptedGui('restor_panel_can_gather').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
							blockoverride "action_dim" { text = "RESTOR_PANEL_ACTION_GATHER" visible = "[Not( GetScriptedGui('restor_panel_can_gather').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]" }
						}
						restor_action_row = {
							blockoverride "action_tt" { tooltip = "RESTOR_PANEL_ACTION_ERRAND_TT" }
							blockoverride "action_lit" { text = "RESTOR_PANEL_ACTION_ERRAND" visible = "[GetScriptedGui('restor_panel_can_errand').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
							blockoverride "action_dim" { text = "RESTOR_PANEL_ACTION_ERRAND" visible = "[Not( GetScriptedGui('restor_panel_can_errand').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]" }
						}
					}

					# ---- 6. People: the lists live in gen_restor_people_window beside the panel --------

					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 10 4 }
						spacing = 10

						button_standard = {
							size = { 200 32 }
							text = "RESTOR_PEOPLE_BUTTON_MEMBERS"
							down = "[GetVariableSystem.HasValue( 'restor_people', 'members' )]"
							onclick = "[GetVariableSystem.Set( 'restor_people', 'members' )]"
						}
						button_standard = {
							size = { 200 32 }
							visible = "[GetScriptedGui('restor_panel_underground').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							text = "RESTOR_PEOPLE_BUTTON_REACH"
							down = "[GetVariableSystem.HasValue( 'restor_people', 'reach' )]"
							onclick = "[GetVariableSystem.Set( 'restor_people', 'reach' )]"
						}
						expand = {}
					}

					expand = {}
				}
			}
		}
	}

	# The people window: the sworn you know, or those within reach, one at a time. Opens to the left
	# of the panel from its two buttons; the choice is a GetVariableSystem key (restor_people =
	# members / reach), cleared by the X, Escape, and the panel closing. The lists themselves are
	# filled by the panel's gathers, as before.
	type gen_restor_people_window = window {
		name = "gen_restor_people_window"
		movable = no
		parentanchor = top|right
		position = { -660 110 }
		size = { 560 720 }
		using = Window_Background_Popup
		using = Window_Decoration

		visible = "[And( And( GetVariableSystem.Exists( 'restor_people' ), GetScriptedGui('society_panel_window').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ), And( GetScriptedGui('restor_panel_viewer_member').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), Not( IsRightWindowOpen ) ) )]"

		state = {
			name = _show
			using = Animation_FadeIn_Quick
		}

		state = {
			name = _hide
			using = Animation_FadeOut_Quick
		}

		margin_widget = {
			size = { 100% 100% }
			margin_top = 10
			margin_bottom = 15

			widget = {
				size = { 100% 100% }

				vbox = {
					using = Window_Margins
					spacing = 6

					header_standard = {
						layoutpolicy_horizontal = expanding
						blockoverride "header_text" {
							text = "RESTOR_PEOPLE_TITLE"
						}
						blockoverride "button_close" {
							onclick = "[GetVariableSystem.Clear( 'restor_people' )]"
							shortcut = "close_window"
						}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 10 0 }
						spacing = 10
						visible = "[GetScriptedGui('restor_panel_underground').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

						button_standard_small = {
							text = "RESTOR_PEOPLE_BUTTON_MEMBERS"
							down = "[GetVariableSystem.HasValue( 'restor_people', 'members' )]"
							onclick = "[GetVariableSystem.Set( 'restor_people', 'members' )]"
						}
						button_standard_small = {
							text = "RESTOR_PEOPLE_BUTTON_REACH"
							down = "[GetVariableSystem.HasValue( 'restor_people', 'reach' )]"
							onclick = "[GetVariableSystem.Set( 'restor_people', 'reach' )]"
						}
						expand = {}
					}

					# ---- Within reach -----------------------------------------------------------------
					# Who the viewer could approach, and what the order has learned of them -- never how
					# they would answer. The button opens the real interactions (filter_tags =
					# restor_recruitment), so their cooldowns and failures are the interactions' own.

					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						visible = "[And( GetVariableSystem.HasValue( 'restor_people', 'reach' ), GetScriptedGui('restor_panel_underground').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"

						text_single = {
							layoutpolicy_horizontal = expanding
							margin_top = 4
							margin_left = 10
							align = left
							default_format = "#weak"
							text = "RESTOR_PANEL_REACH_HEADER"
							tooltip = "RESTOR_PANEL_REACH_HINT"
						}

						scrollbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding

							blockoverride "scrollbox_content" {
								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 4
									datamodel = "[GetPlayer.MakeScope.GetList( 'restor_panel_candidates' )]"

									item = {
										hbox = {
											datacontext = "[Scope.Char]"
											layoutpolicy_horizontal = expanding
											spacing = 10
											margin_right = 12
											background = {
												texture = "gfx/interface/component_masks/mask_brushed.dds"
												color = { 0.2 0.2 0.31 0.45 }
											}

											portrait_head_small = {}

											vbox = {
												layoutpolicy_horizontal = expanding
												text_single = {
													layoutpolicy_horizontal = expanding
													align = left
													default_format = "#high"
													text = "[Character.GetName]"
												}
												text_single = {
													layoutpolicy_horizontal = expanding
													align = left
													default_format = "#weak"
													visible = "[Character.IsRuler]"
													text = "[Character.GetPrimaryTitle.GetNameNoTooltip]"
												}
												text_single = {
													layoutpolicy_horizontal = expanding
													align = left
													default_format = "#weak"
													visible = "[GetScriptedGui('restor_panel_reach_blood').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
													text = "RESTOR_REACH_BLOOD"
												}
											}

											vbox = {
												text_single = {
													align = right
													default_format = "#high"
													text = "RESTOR_REACH_SYMPATHETIC"
													visible = "[GetScriptedGui('restor_panel_reach_sympathetic').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
												}
												text_single = {
													align = right
													default_format = "#weak"
													text = "RESTOR_REACH_REFUSED"
													visible = "[GetScriptedGui('restor_panel_reach_refused').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
												}
											}

											button_standard_small = {
												size = { 90 25 }
												text = "RESTOR_REACH_APPROACH"
												tooltip = "RESTOR_REACH_APPROACH_TT"
												onclick = "[ToggleFilteredCharacterInteractionMenu( Character.Self, 'restor_recruitment' )]"
											}
										}
									}
								}
							}

							blockoverride "scrollbox_empty" {
								visible = "[IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'restor_panel_candidates' ) )]"
								text = "RESTOR_PANEL_REACH_EMPTY"
							}
						}
					}

					# ---- The roster -------------------------------------------------------------------

					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						visible = "[GetVariableSystem.HasValue( 'restor_people', 'members' )]"

					text_single = {
						layoutpolicy_horizontal = expanding
						margin_top = 4
						margin_left = 10
						align = left
						default_format = "#weak"
						text = "RESTOR_PANEL_ROSTER_HEADER"
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						blockoverride "scrollbox_content" {
							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								datamodel = "[GetPlayer.MakeScope.GetList( 'restor_panel_roster' )]"

								item = {
									hbox = {
										datacontext = "[Scope.Char]"
										layoutpolicy_horizontal = expanding
										spacing = 10
										margin_right = 12
										background = {
											texture = "gfx/interface/component_masks/mask_brushed.dds"
											color = { 0.2 0.2 0.31 0.45 }
										}

										portrait_head_small = {}

										vbox = {
											layoutpolicy_horizontal = expanding
											text_single = {
												layoutpolicy_horizontal = expanding
												align = left
												default_format = "#high"
												text = "[Character.GetName]"
											}
											text_single = {
												layoutpolicy_horizontal = expanding
												align = left
												default_format = "#weak"
												visible = "[Character.IsRuler]"
												text = "[Character.GetPrimaryTitle.GetNameNoTooltip]"
											}
										}

										vbox = {
											text_single = {
												align = right
												default_format = "#high"
												text = "RESTOR_ROSTER_HEIR"
												visible = "[GetScriptedGui('restor_panel_is_pretender').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
											}
											text_single = {
												align = right
												default_format = "#high"
												text = "RESTOR_ROSTER_KEEPER"
												visible = "[GetScriptedGui('restor_panel_is_keeper').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
											}
											text_single = {
												align = right
												text = "RESTOR_RANK_0"
												visible = "[GetScriptedGui('restor_panel_rank_0').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
											}
											text_single = {
												align = right
												text = "RESTOR_RANK_1"
												visible = "[GetScriptedGui('restor_panel_rank_1').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
											}
											text_single = {
												align = right
												text = "RESTOR_RANK_2"
												visible = "[GetScriptedGui('restor_panel_rank_2').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
											}
											text_single = {
												align = right
												text = "RESTOR_RANK_3"
												visible = "[GetScriptedGui('restor_panel_rank_3').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
											}
											text_single = {
												align = right
												default_format = "#V"
												text = "RESTOR_ROSTER_SUSPECT"
												visible = "[GetScriptedGui('restor_panel_suspect').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
											}
											text_single = {
												align = right
												default_format = "#X"
												text = "RESTOR_ROSTER_VERY_SUSPECT"
												visible = "[GetScriptedGui('restor_panel_very_suspect').IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
											}
										}
									}
								}
							}
						}

						blockoverride "scrollbox_empty" {
							visible = "[IsDataModelEmpty( GetPlayer.MakeScope.GetList( 'restor_panel_roster' ) )]"
							text = "RESTOR_PANEL_ROSTER_EMPTY"
						}
					}
					}
				}
			}
		}
	}

	# One of the people at the top: a label, a face, a name. The face opens the character like any
	# vanilla portrait does.
	type restor_person_slot = vbox {
		spacing = 2
		minimumsize = { 130 -1 }
		text_single = {
			default_format = "#weak"
			align = hcenter
			block "slot_label" {}
		}
		portrait_head_small = {}
		text_single = {
			align = hcenter
			default_format = "#high"
			max_width = 130
			text = "[Character.GetFirstNameNoTooltip]"
		}
	}

	# A labelled meter: label top-left, value top-right over the bar's end, the bar under them, and
	# room at the bottom for an optional note (anchored bottom|right by the use site).
	#
	# A fixed rectangle with anchored children rather than stacked boxes, on purpose: the value has
	# to sit exactly over the bar's right end, and an expanding row inside a box decides its width
	# from the parent, which put the value at the card's edge instead. The threshold marks are
	# placed in pixels for the same reason: a mark at value v on a bar w wide goes at
	# x = w * v / max, less half the mark's 4px.
	type restor_meter = widget {
		block "meter_size" { size = { 510 40 } }
		text_single = {
			parentanchor = top|left
			default_format = "#weak"
			block "meter_label" {}
			block "meter_tt" {}
		}
		text_single = {
			parentanchor = top|right
			default_format = "#high"
			block "meter_value" {}
			block "meter_tt" {}
		}
		widget = {
			position = { 0 25 }
			size = { 100% 14 }
			block "meter_tt" {}
			block "meter_bar" {}
			block "meter_marks" {}
		}
		block "meter_note" {}
	}

	# Vanilla's standard bar with a black empty half instead of its red one: red reads as "bad", and
	# support not yet gathered is not bad, only not yet.
	type restor_bar = progressbar_standard {
		size = { 100% 100% }
		min = 0
		max = 100
		blockoverride "progress_textures" {
			progresstexture = "gfx/interface/progressbars/progress_standard.dds"
			noprogresstexture = "gfx/interface/progressbars/progress_black.dds"
		}
	}

	# Exposure fills red: this one is bad.
	type restor_bar_red = progressbar_red {
		size = { 100% 100% }
		min = 0
		max = 100
	}

	# Vanilla's threshold tick (raids, sieges). Not alwaystransparent, so its tooltip can say what
	# happens at that point.
	type restor_mark = progress_threshold {
		size = { 4 20 }
		alwaystransparent = no
	}

	# One plate of the rung ladder. rung_on shows the lit plate and bright name; rung_off the dim name.
	type restor_rung = widget {
		size = { 125 28 }
		background = { using = Background_Area_Dark }
		widget = {
			size = { 100% 100% }
			block "rung_on" {}
			background = {
				texture = "gfx/interface/colors/white.dds"
				color = { 0.85 0.7 0.4 0.28 }
			}
		}
		text_single = {
			parentanchor = center
			default_format = "#high"
			block "rung_on" {}
			block "rung_text" {}
		}
		text_single = {
			parentanchor = center
			default_format = "#weak"
			block "rung_off" {}
			block "rung_text" {}
		}
	}

	# An action the viewer can take, lit when they can take it now and dimmed when they cannot. The
	# row is the action's name; what it needs is the tooltip ("action_tt"). max_width because a vbox
	# grows to its widest child: a row with its requirement written out ran wider than the column and
	# pushed every right-aligned value on the panel under the HUD's icon bar.
	type restor_action_row = hbox {
		layoutpolicy_horizontal = expanding
		ignoreinvisible = yes
		text_single = {
			layoutpolicy_horizontal = expanding
			max_width = 520
			align = left
			default_format = "#high"
			block "action_lit" {}
			block "action_tt" {}
		}
		text_single = {
			layoutpolicy_horizontal = expanding
			max_width = 520
			align = left
			default_format = "#weak"
			block "action_dim" {}
			block "action_tt" {}
		}
	}

	# A wrapped paragraph held to the left edge. A bare text_multi narrower than its vbox is centred
	# in it, so paragraphs sat ~20px further in than the labels around them; the expand pushes this
	# one left. 520 fits the ~540 inside a margined box (the budget note above the main vbox).
	type restor_para = hbox {
		layoutpolicy_horizontal = expanding
		text_multi = {
			autoresize = yes
			max_width = 520
			block "para" {}
		}
		expand = {}
	}
}

gen_society_panel_host = {}
