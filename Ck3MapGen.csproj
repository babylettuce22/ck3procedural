<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe, not Exe: the GUI is the primary front end and a console window flashing up behind
         it is noise. Output still reaches a terminal that launched it, because a Windows GUI
         process inherits the parent's stdout handle, so driving the CLI through dotnet run prints
         exactly as before. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Embedded Executable Icon -->
    <ApplicationIcon>app.ico</ApplicationIcon>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<ServerGarbageCollection>true</ServerGarbageCollection>
	<InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Stamped into the PE version resource. Signing aside, an unsigned binary with a blank
         version block is itself a heuristic signal to antivirus, and SignPath checks that the
         artifact's metadata matches what the signing policy declares. Version is overridden by
         the release workflow from the git tag; the value here is what local builds report. -->
    <Product>CK3 Procedural Map Generator</Product>
    <!-- Shown as the file description in Explorer and in the SmartScreen prompt; without it the
         PE reports the bare assembly name. -->
    <AssemblyTitle>CK3 Procedural Map Generator</AssemblyTitle>
    <Company>babylettuce22</Company>
    <Authors>babylettuce22</Authors>
    <Copyright>Copyright (c) 2026 babylettuce22</Copyright>
    <Description>Generates a complete, playable Crusader Kings III map mod from an Azgaar Fantasy Map Generator export.</Description>
    <PackageProjectUrl>https://github.com/babylettuce22/ck3procedural</PackageProjectUrl>
    <RepositoryUrl>https://github.com/babylettuce22/ck3procedural</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version Condition="'$(Version)' == ''">0.7.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The heightmap pipeline (CK3 Heightmap Forge) lives in its own repo beside this one and is
         referenced as source, so the Heightmap tab and the Forge app share one implementation.
         Override NoiseToolDir on the command line or in Directory.Build.props if it lives elsewhere. -->
    <NoiseToolDir Condition="'$(NoiseToolDir)' == ''">..\noisetool\</NoiseToolDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="4.0.0" />
    <ProjectReference Include="$(NoiseToolDir)NoiseTool.Core\NoiseTool.Core.csproj" />
    <ProjectReference Include="$(NoiseToolDir)NoiseTool.Ui\NoiseTool.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Files we keep by hand and copy into the mod verbatim; see Emit/StaticFileWriter.cs.
         Each immediate subfolder is one file set (Core, Wilderness, ...). They ship beside the
         executable, which is where that writer looks for them, so a published build carries them
         without needing the repo. -->
    <None Update="BaseFilesToCopy/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
