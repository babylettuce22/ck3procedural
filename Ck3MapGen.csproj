<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe, not Exe: the GUI is the primary front end and a console window flashing up behind
         it is noise. Output still reaches a terminal that launched it, because a Windows GUI
         process inherits the parent's stdout handle, so driving the CLI through dotnet run prints
         exactly as before. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<ServerGarbageCollection>true</ServerGarbageCollection>
	<InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vanilla files we keep by hand and copy into the mod verbatim; see Emit/StaticFileWriter.cs.
         They ship beside the executable, which is where that writer looks for them, so a published
         build carries them without needing the repo. -->
    <None Update="VanillaFilesToCopy/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
